; Engine configuration file.
config_version=5

[application]

config/name="Moss / Ink"
config/description="A dithered 3D field study. Grow, tune and share a living ink landscape."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.851, 0.867, 0.878, 1)
config/icon="res://icon.png"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="disabled"
window/dpi/allow_hidpi=true
window/energy_saving/keep_screen_on=false

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.851, 0.867, 0.878, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=0
textures/vram_compression/import_etc2_astc=true
